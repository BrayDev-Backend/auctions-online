PORT=3000
NODE_ENV=development

# PostgreSQL (used by docker-compose and by Prisma)
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=auctions
DB_HOST=localhost
DB_PORT=5432
# Must match the DB_* values above
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/auctions?schema=public

# Auth
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10

# Socket.io
CORS_ORIGIN=*

# Payment webhook (not used yet)
WEBHOOK_SECRET=your_payment_webhook_secret_key
